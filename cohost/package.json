{
  "name": "cohost-w6w",
  "version": "0.3.0",
  "description": "Cohost app for w6w — order triggers (placed / changed) and a get-order action. Replaces the legacy runtime-server + workflows.",
  "license": "MIT",
  "author": {
    "name": "Cohost",
    "url": "https://cohost.vip"
  },
  "keywords": [
    "cohost",
    "w6w",
    "events",
    "ticketing",
    "orders",
    "webhooks"
  ],
  "type": "module",
  "main": "./app.js",
  "w6w": {
    "id": "vip.cohost.w6w",
    "displayName": "Cohost",
    "description": "React to Cohost order events and fetch order details by id or URN.",
    "categories": [
      "commerce",
      "marketing"
    ],
    "appearance": {
      "icon": {
        "url": "./assets/icon.svg",
        "alt": "Cohost"
      },
      "brandColor": "#f97316",
      "darkMode": {
        "icon": {
          "url": "./assets/icon-dark.svg",
          "alt": "Cohost"
        }
      }
    },
    "network": {
      "allow": [
        "api.cohost.vip"
      ]
    },
    "entry": "./app.js"
  }
}
