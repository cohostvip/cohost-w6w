    "categories": ["commerce", "migration", "transformer"],
    "appearance": {
      "icon": { "url": "./assets/icon.svg", "alt": "Eventbrite ⇄ Cohost" },
      "brandColor": "#f05537",
      "darkMode": {
        "icon": { "url": "./assets/icon-dark.svg", "alt": "Eventbrite ⇄ Cohost" }
      }
    },
    "network": { "allow": [] },
    "entry": "./index.ts"
  }
